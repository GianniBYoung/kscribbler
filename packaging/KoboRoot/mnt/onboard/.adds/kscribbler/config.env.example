# place your personal access token (PAT) inside of the quotes
HARDCOVER_API_TOKEN=""

# set to "true" to upload annotations (notes) alongside quotes
UPLOAD_ANNOTATIONS="false"

# privacy for uploaded journal entries: "public", "followers", or "private"
PRIVACY="public"

# update channel used by "Upgrade Kscribbler": "stable", "testing", or a release tag like "v1.4.0"
UPDATE_CHANNEL="stable"
